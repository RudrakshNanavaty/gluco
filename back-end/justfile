# Run `just` to list targets. Every recipe goes through `uv run`, so no venv
# needs to be activated.

default:
    @just --list

# Run the API with the configured DATA_BACKEND
run:
    uv run agent serve

# Run the API against the seeded mock data, whatever .env says
mock:
    DATA_BACKEND=mock uv run agent serve

# One question in the terminal (no server): just ask "Who needs follow-up?"
# As a patient: just ask "Why did my score drop?" 13
ask question who="clinician":
    uv run agent ask --as "{{who}}" "{{question}}"

# Run the eval set (calls the real model): just eval, or just eval --tier 2
eval *args:
    uv run python evals/run.py {{args}}

# Create or update a Clerk account for every participant (needs CLERK_SECRET_KEY and
# CLERK_DEMO_PASSWORD): just seed-clerk --dry-run, then just seed-clerk
seed-clerk *args:
    uv run python -m agent.clerk_seed {{args}}

test:
    uv run pytest

# Read-only checks against the real database configured in .env
test-live:
    LIVE_DB=1 uv run pytest tests/test_postgres_live.py -v

lint:
    uv run ruff check . && uv run ruff format --check . && uv run basedpyright
