# Base URL of the Gluco FastAPI back-end (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Clerk publishable key (Clerk dashboard > API keys). Clerk is the only sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Optional catch-all page handles Clerk sign-in and verification subpaths.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
